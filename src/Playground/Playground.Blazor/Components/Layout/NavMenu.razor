@using FSH.Framework.Shared.Constants
@using FSH.Framework.Shared.Multitenancy
@using Microsoft.AspNetCore.Components.Authorization
@using FSH.BuildingBlocks.Blazor.UI.Navigation
@using FSH.Playground.Blazor.Services
@using System.Security.Claims
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject INavigationRegistry NavigationRegistry
@inject IPermissionService PermissionService
@inject ILogger<NavMenu> Logger

<nav class="fsh-nav">
    <MudNavMenu Class="pa-2" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
        @foreach (var navSection in _visibleSections)
        {
            if (navSection.Id == NavigationSections.Home)
            {
                <!-- Home items without section header -->
                @foreach (var item in _itemsBySection.GetValueOrDefault(navSection.Id, []))
                {
                    if (ShouldShowItem(item))
                    {
                        <MudNavLink Href="@item.Href" Match="NavLinkMatch.All" Icon="@item.Icon">
                            @item.Title
                        </MudNavLink>
                    }
                }
            }
            else
            {
                var sectionItems = _itemsBySection.GetValueOrDefault(navSection.Id, [])
                    .Where(ShouldShowItem)
                    .ToList();

                @if (sectionItems.Any())
                {
                    <!-- Section title -->
                    <div class="fsh-nav-section-title">@navSection.Title</div>

                    <!-- Section items -->
                    @foreach (var item in sectionItems)
                    {
                        <MudNavLink Href="@item.Href" Match="NavLinkMatch.Prefix" Icon="@item.Icon">
                            @item.Title
                        </MudNavLink>
                    }
                }
            }
        }
    </MudNavMenu>
</nav>

@code {
    private bool _isRootTenantAdmin;
    private IReadOnlyList<NavigationSection> _visibleSections = [];
    private Dictionary<string, IReadOnlyList<NavigationItem>> _itemsBySection = [];
    private ClaimsPrincipal? _user;
    private List<string> _userPermissions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNavigationAsync();
    }

    private async Task LoadNavigationAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User;
        _isRootTenantAdmin = CheckRootTenantAdmin(_user);

        // Load user permissions from API
        if (_user?.Identity?.IsAuthenticated == true)
        {
            try
            {
                var permissionsResult = await PermissionService.GetPermissionsAsync();
                
                if (permissionsResult == null)
                {
                    Logger.LogWarning("Failed to load user permissions - permissions will be empty");
                    _userPermissions = new List<string>();
                }
                else
                {
                    _userPermissions = permissionsResult;
                    Logger.LogInformation("Loaded {Count} permissions for user from API", _userPermissions.Count);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Exception loading user permissions");
                _userPermissions = new List<string>();
            }
        }
        else
        {
            _userPermissions = new List<string>();
        }

        // Get sections and items from registry
        _visibleSections = NavigationRegistry.GetSections();
        _itemsBySection = _visibleSections
            .ToDictionary(
                s => s.Id,
                s => NavigationRegistry.GetItemsForSection(s.Id));

        // Debug logging
        Logger.LogInformation("NavMenu: Total sections: {SectionCount}", _visibleSections.Count);
        Logger.LogInformation("NavMenu: User has {PermissionCount} permissions", _userPermissions.Count);
        
        foreach (var section in _visibleSections)
        {
            var items = _itemsBySection.GetValueOrDefault(section.Id, []);
            Logger.LogInformation("NavMenu: Section '{SectionTitle}' has {ItemCount} items", section.Title, items.Count);
            foreach (var item in items)
            {
                var shouldShow = ShouldShowItem(item);
                Logger.LogInformation("NavMenu: Item '{ItemTitle}' visible: {IsVisible}", item.Title, shouldShow);
            }
        }
    }

    private bool CheckRootTenantAdmin(ClaimsPrincipal? user)
    {
        if (user == null)
            return false;

        try
        {
            if (user.Identity?.IsAuthenticated != true)
            {
                return false;
            }

            var tenant = user.FindFirst(CustomClaims.Tenant)?.Value;
            var isRootTenant = string.Equals(tenant, MultitenancyConstants.Root.Id, StringComparison.OrdinalIgnoreCase);

            var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            var isAdmin = roles.Any(r => string.Equals(r, RoleConstants.Admin, StringComparison.OrdinalIgnoreCase));

            return isRootTenant && isAdmin;
        }
        catch
        {
            return false;
        }
    }

    private bool ShouldShowItem(NavigationItem item)
    {
        if (!item.IsVisible)
        {
            Logger.LogDebug("Item '{ItemTitle}' not visible (IsVisible=false)", item.Title);
            return false;
        }

        // If item has no restrictions, show it regardless of authentication
        var hasRestrictions = item.RequiresRootTenantAdmin 
            || !string.IsNullOrWhiteSpace(item.RequiredPermission)
            || item.RequiredRoles?.Length > 0;

        if (!hasRestrictions)
        {
            Logger.LogDebug("Item '{ItemTitle}' has no restrictions, showing", item.Title);
            return true;
        }

        // For items with restrictions, check authentication
        if (_user?.Identity?.IsAuthenticated != true)
        {
            Logger.LogDebug("Item '{ItemTitle}' requires auth but user not authenticated", item.Title);
            return false;
        }

        // Check root tenant admin requirement
        if (item.RequiresRootTenantAdmin && !_isRootTenantAdmin)
        {
            Logger.LogDebug("Item '{ItemTitle}' requires root tenant admin but user is not", item.Title);
            return false;
        }

        // Check permission requirement - NOW USES API CALL RESULTS
        if (!string.IsNullOrWhiteSpace(item.RequiredPermission))
        {
            Logger.LogInformation("Checking permission for item '{ItemTitle}': {Permission}", 
                item.Title, item.RequiredPermission);
            
            Logger.LogDebug("User permissions from API: {@Permissions}", _userPermissions);
            
            var hasPermission = _userPermissions.Contains(item.RequiredPermission);
            
            Logger.LogInformation("Permission check for '{Permission}': {Result}", 
                item.RequiredPermission, hasPermission ? "GRANTED" : "DENIED");
            
            if (!hasPermission)
                return false;
        }

        // Check role requirements
        if (item.RequiredRoles?.Length > 0)
        {
            var userRoles = _user.FindAll(System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            Logger.LogInformation("Checking roles for item '{ItemTitle}'. Required: {@RequiredRoles}, User has: {@UserRoles}", 
                item.Title, item.RequiredRoles, userRoles);

            var hasRequiredRole = item.RequiredRoles.Any(r => userRoles.Contains(r));
            
            Logger.LogInformation("Role check: {Result}", hasRequiredRole ? "GRANTED" : "DENIED");
            
            if (!hasRequiredRole)
                return false;
        }

        Logger.LogInformation("Item '{ItemTitle}' passed all checks, showing", item.Title);
        return true;
    }
}
